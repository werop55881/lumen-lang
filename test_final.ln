print: "Hello, world!"

fun fib(n) {
    if (n <= 1) { return n }
    return fib(n - 1) + fib(n - 2)
}

print: fib(10)

let nums = [10, 20, 30]
print: nums[1]
print: nums[2]
print: nums[3]

nums[1] = 99
print: nums[1]
print: nums

let m = {a: 1, b: 2}
print: m.a
print: m["a"]

try {
    print: 10 / 0
} catch e {
    print: "caught: {e}"
}

print: max(range(5))
print: min(range(5))
print: len("hello")
print: upper("hello")
print: lower("WORLD")
