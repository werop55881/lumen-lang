{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Lumen File",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/run-lumen.ps1",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "Run Current File (Terminal)",
            "type": "shell",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/run-lumen.ps1\" \"${file}\"",
            "group": "none",
            "problemMatcher": []
        }
    ]
}
